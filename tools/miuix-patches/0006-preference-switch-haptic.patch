---
 .../miuix/kmp/preference/SwitchPreference.kt     | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/miuix-preference/src/commonMain/kotlin/top/yukonga/miuix/kmp/preference/SwitchPreference.kt b/miuix-preference/src/commonMain/kotlin/top/yukonga/miuix/kmp/preference/SwitchPreference.kt
index 13f3b03..b07a5cd 100644
--- a/miuix-preference/src/commonMain/kotlin/top/yukonga/miuix/kmp/preference/SwitchPreference.kt
+++ b/miuix-preference/src/commonMain/kotlin/top/yukonga/miuix/kmp/preference/SwitchPreference.kt
@@ -13,6 +13,8 @@ import androidx.compose.runtime.remember
 import androidx.compose.runtime.rememberUpdatedState
 import androidx.compose.ui.Alignment
 import androidx.compose.ui.Modifier
+import androidx.compose.ui.hapticfeedback.HapticFeedbackType
+import androidx.compose.ui.platform.LocalHapticFeedback
 import androidx.compose.ui.semantics.Role
 import androidx.compose.ui.unit.dp
 import top.yukonga.miuix.kmp.basic.BasicComponent
@@ -60,8 +62,20 @@ fun SwitchPreference(
     val currentOnCheckedChange by rememberUpdatedState(onCheckedChange)
     val currentChecked by rememberUpdatedState(checked)
     val currentEnabled by rememberUpdatedState(enabled)
+    val hapticFeedback = LocalHapticFeedback.current
+    val currentHapticFeedback by rememberUpdatedState(hapticFeedback)
     val onRowClick = remember {
-        { currentOnCheckedChange.takeIf { currentEnabled }?.invoke(!currentChecked) ?: Unit }
+        {
+            currentOnCheckedChange.takeIf { currentEnabled }?.let { change ->
+                val newChecked = !currentChecked
+                change(newChecked)
+                // 点整行切换时 Switch 自身不会触发震动，这里补上（与 Switch 保持一致）
+                currentHapticFeedback.performHapticFeedback(
+                    if (newChecked) HapticFeedbackType.ToggleOn else HapticFeedbackType.ToggleOff,
+                )
+            }
+            Unit
+        }
     }
     BasicComponent(
         modifier = modifier,
