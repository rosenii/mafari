diff --git a/miuix-blur/src/commonMain/kotlin/top/yukonga/miuix/kmp/blur/BackdropEffectScope.kt b/miuix-blur/src/commonMain/kotlin/top/yukonga/miuix/kmp/blur/BackdropEffectScope.kt
index 4e3e96c4..2009caa8 100644
--- a/miuix-blur/src/commonMain/kotlin/top/yukonga/miuix/kmp/blur/BackdropEffectScope.kt
+++ b/miuix-blur/src/commonMain/kotlin/top/yukonga/miuix/kmp/blur/BackdropEffectScope.kt
@@ -34,6 +34,17 @@ sealed interface BackdropEffectScope :
      */
     var padding: Float
 
+    /**
+     * Per-side padding actually recorded around the component: [padding] clamped to the room the
+     * backdrop layer has on that side (a component near the screen edge gets less padding there).
+     * Effects that map component coordinates into the padded layer (shaders) must use these, not
+     * a symmetric [padding], or the component origin shifts by the clamped amount.
+     */
+    val paddingLeft: Float
+    val paddingTop: Float
+    val paddingRight: Float
+    val paddingBottom: Float
+
     /** The accumulated render effect chain. */
     var renderEffect: RenderEffect?
 
@@ -152,6 +163,10 @@ internal abstract class BackdropEffectScopeImpl :
     override var size: Size = Size.Unspecified
     override var layoutDirection: LayoutDirection = LayoutDirection.Ltr
     override var padding: Float = 0f
+    override val paddingLeft: Float get() = minOf(padding, maxPadLeft)
+    override val paddingTop: Float get() = minOf(padding, maxPadTop)
+    override val paddingRight: Float get() = minOf(padding, maxPadRight)
+    override val paddingBottom: Float get() = minOf(padding, maxPadBottom)
     override var renderEffect: RenderEffect? = null
     override var downscaleFactor: Float = 1f
     override var noiseCoefficient: Float = 0f
diff --git a/miuix-glass/src/commonMain/kotlin/top/yukonga/miuix/kmp/glass/internal/GlassUniforms.kt b/miuix-glass/src/commonMain/kotlin/top/yukonga/miuix/kmp/glass/internal/GlassUniforms.kt
index eab6281b..dc7bac5f 100644
--- a/miuix-glass/src/commonMain/kotlin/top/yukonga/miuix/kmp/glass/internal/GlassUniforms.kt
+++ b/miuix-glass/src/commonMain/kotlin/top/yukonga/miuix/kmp/glass/internal/GlassUniforms.kt
@@ -40,8 +40,12 @@ internal fun BackdropEffectScope.glassEffect(
     if (width <= 0f || height <= 0f) return
 
     val scale = downscaleFactor
-    val paddedWidth = width + padding * 2f
-    val paddedHeight = height + padding * 2f
+    // 逐边 padding：元素靠近背景层边缘时 blur 会把对应一侧的 padding 裁小，
+    // 这里必须用同样的值，否则组件原点在 padded 图层里整体偏移（左侧一条没被模糊 / 折射错位）
+    val padL = paddingLeft
+    val padT = paddingTop
+    val paddedWidth = width + padL + paddingRight
+    val paddedHeight = height + padT + paddingBottom
     val textureWidth = (paddedWidth / downscaleFactor).coerceAtLeast(1f)
     val textureHeight = (paddedHeight / downscaleFactor).coerceAtLeast(1f)
 
@@ -58,7 +62,7 @@ internal fun BackdropEffectScope.glassEffect(
 
     runtimeShaderEffect(GLASS_SHADER_KEY, GLASS_SHADER, "child") {
         setSilhouetteUniforms(shape, layoutDirection, size, this@glassEffect, scale)
-        setFloatUniform("in_pad", padding / scale, padding / scale)
+        setFloatUniform("in_pad", padL / scale, padT / scale)
         setFloatUniform("in_maxCoord", textureWidth - 0.5f, textureHeight - 0.5f)
         setFloatUniform(
             "in_alphaEdge",
