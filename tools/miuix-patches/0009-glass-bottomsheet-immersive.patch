+/**
+ * Immersive sheet body: the content fills the whole sheet and the header (drag handle, title and
+ * actions) is laid over its top edge instead of above it.
+ *
+ * The header is measured first so its height can be handed to the content through
+ * [LocalBottomSheetInsets] in the same frame (no one-frame jump); the content is expected to keep
+ * `top` clear at rest and may scroll underneath it. The bottom inset is the navigation bar height,
+ * reported the same way. The header swallows taps so a hidden item under it cannot be clicked.
+ */
+@Composable
+private fun ImmersiveSheetBody(
+    header: @Composable () -> Unit,
+    content: @Composable () -> Unit,
+) {
+    val navBottom = WindowInsets.navigationBars.asPaddingValues().calculateBottomPadding()
+    SubcomposeLayout(modifier = Modifier.fillMaxWidth()) { constraints ->
+        val width = constraints.maxWidth
+        val childConstraints = Constraints(
+            minWidth = width,
+            maxWidth = width,
+            minHeight = 0,
+            maxHeight = constraints.maxHeight,
+        )
+        val headerPlaceables = subcompose(ImmersiveSlot.Header) {
+            Column(
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .pointerInput(Unit) { detectTapGestures { /* Swallow taps */ } },
+            ) { header() }
+        }.map { it.measure(childConstraints) }
+        val headerHeight = headerPlaceables.maxOfOrNull { it.height } ?: 0
+        val insets = BottomSheetInsets(top = headerHeight.toDp(), bottom = navBottom)
+        val contentPlaceables = subcompose(ImmersiveSlot.Content) {
+            CompositionLocalProvider(LocalBottomSheetInsets provides insets) { content() }
+        }.map { it.measure(childConstraints) }
+        val height = maxOf(headerHeight, contentPlaceables.maxOfOrNull { it.height } ?: 0)
+        layout(width, height) {
+            contentPlaceables.forEach { it.place(0, 0) }
+            headerPlaceables.forEach { it.place(0, 0) }
         }
     }
 }
 
+private enum class ImmersiveSlot { Header, Content }
+
