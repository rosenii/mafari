+package top.yukonga.miuix.kmp.layout
+
+import androidx.compose.runtime.Immutable
+import androidx.compose.runtime.staticCompositionLocalOf
+import androidx.compose.ui.unit.Dp
+import androidx.compose.ui.unit.dp
+
+/**
+ * Space an immersive bottom sheet's content has to keep clear.
+ *
+ * @param top Height of the floating header (drag handle plus title row).
+ * @param bottom Height of the navigation bar the content extends under.
+ */
+@Immutable
+class BottomSheetInsets(
+    val top: Dp = 0.dp,
+    val bottom: Dp = 0.dp,
+) {
+    override fun equals(other: Any?): Boolean = other is BottomSheetInsets && other.top == top && other.bottom == bottom
+
+    override fun hashCode(): Int = 31 * top.hashCode() + bottom.hashCode()
+}
+
+/**
+ * Provided to the content of a bottom sheet shown with `immersive = true`. Outside an immersive
+ * sheet it stays at zero.
+ */
+val LocalBottomSheetInsets = staticCompositionLocalOf { BottomSheetInsets() }
