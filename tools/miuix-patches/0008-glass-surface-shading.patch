+// Copyright 2026, compose-miuix-ui contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package top.yukonga.miuix.kmp.glass
+
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.graphics.luminance
+import top.yukonga.miuix.kmp.material.GlassDefaults
+import top.yukonga.miuix.kmp.material.GlassStyle
+import top.yukonga.miuix.kmp.theme.MiuixTheme
+
+/**
+ * Process-wide default for the refraction and rim lighting ("shading") of popup, dialog and
+ * bottom-sheet glass surfaces. Upstream keeps these surfaces flat; set [enabled] once at startup
+ * to opt in. Explicit parameters on the individual surfaces still win.
+ */
+object GlassSurfaceShading {
+    /** Whether popup, dialog and bottom-sheet surfaces refract and shade the backdrop. */
+    @JvmField
+    var enabled: Boolean = false
+
+    /** Style used for light themes by surfaces that do not receive one explicitly. */
+    @JvmField
+    var lightStyle: GlassStyle = GlassDefaults.Style
+
+    /** Style used for dark themes by surfaces that do not receive one explicitly. */
+    @JvmField
+    var darkStyle: GlassStyle = GlassDefaults.Style
+
+    /** Style for [isDark]. */
+    fun style(isDark: Boolean): GlassStyle = if (isDark) darkStyle else lightStyle
+
+    /** Style for the current Miuix theme. */
+    @Composable
+    fun style(): GlassStyle = style(MiuixTheme.colorScheme.background.luminance() < 0.5f)
+}
