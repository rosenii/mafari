---
 .../commonMain/kotlin/top/yukonga/miuix/kmp/glass/Glass.kt    | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/miuix-glass/src/commonMain/kotlin/top/yukonga/miuix/kmp/glass/Glass.kt b/miuix-glass/src/commonMain/kotlin/top/yukonga/miuix/kmp/glass/Glass.kt
index 423cce5..c720553 100644
--- a/miuix-glass/src/commonMain/kotlin/top/yukonga/miuix/kmp/glass/Glass.kt
+++ b/miuix-glass/src/commonMain/kotlin/top/yukonga/miuix/kmp/glass/Glass.kt
@@ -169,7 +169,9 @@ private class GlassPipeline(
         with(scope) {
             noiseDither(noiseCoefficient)
             val radius = material?.blurRadius?.value ?: (style.blur.small / GlassDefaults.SourceDensity)
-            blur(radius.coerceIn(0f, BlurDefaults.MaxBlurRadius) * density)
+            // 半径为 0（调用方已提供预模糊的取样源）时整段跳过模糊，省掉每张卡片的离屏模糊 pass
+            val radiusPx = radius.coerceIn(0f, BlurDefaults.MaxBlurRadius) * density
+            if (radiusPx > 0f) blur(radiusPx)
             if (underlayMaterial != null) {
                 colorBlendEffect(underlayMaterial, 1f, "${GLASS_COLOR_BLEND_SHADER_KEY}ActionBar")
             }
