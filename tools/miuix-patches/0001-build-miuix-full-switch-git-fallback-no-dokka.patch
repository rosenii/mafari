diff --git a/build-logic/src/main/kotlin/BuildConfig.kt b/build-logic/src/main/kotlin/BuildConfig.kt
index ac20933..16ccee3 100644
--- a/build-logic/src/main/kotlin/BuildConfig.kt
+++ b/build-logic/src/main/kotlin/BuildConfig.kt
@@ -17,13 +17,22 @@ object BuildConfig {
 }
 
 fun org.gradle.api.Project.getGitVersionCode(): Int {
-    return providers.exec {
-        commandLine("git", "rev-list", "--count", "HEAD")
-    }.standardOutput.asText.get().trim().toInt()
+    return try {
+        providers.exec {
+            commandLine("git", "rev-list", "--count", "HEAD")
+        }.standardOutput.asText.get().trim().toInt()
+    } catch (_: Exception) {
+        // 源码包可能不含 .git，回退到固定值
+        1
+    }
 }
 
 fun org.gradle.api.Project.getGitHashShort(): String {
-    return providers.exec {
-        commandLine("git", "rev-parse", "--short", "HEAD")
-    }.standardOutput.asText.get().trim()
+    return try {
+        providers.exec {
+            commandLine("git", "rev-parse", "--short", "HEAD")
+        }.standardOutput.asText.get().trim().ifBlank { "local" }
+    } catch (_: Exception) {
+        "local"
+    }
 }
