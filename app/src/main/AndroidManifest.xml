<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- DLNA 投屏：SSDP 组播搜索设备（普通权限，安装即授予） -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Android 17（targetSdk 37）起访问局域网（SSDP 搜索 / 连接电视）必须有此运行时权限，属于「附近设备」权限组 -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 原生播放器后台播放：媒体前台服务 + ExoPlayer 熄屏时保持 CPU / Wi-Fi 唤醒 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 16 实时更新（Live Updates）：下载进度显示在状态栏胶囊 / 锁屏 -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />

    <!-- 包可见性：检测已安装的第三方下载器 -->
    <queries>
        <!-- 朗读：列出系统 TTS 引擎 -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <package android:name="com.dv.adm.pay" />
        <package android:name="com.dv.adm" />
        <package android:name="idm.internet.download.manager.plus" />
        <package android:name="idm.internet.download.manager" />
        <package android:name="org.freedownloadmanager.fdm" />
        <package android:name="com.gopeed" />
        <!-- 自动填充下拉里显示原生 App 的名字（见 MafariAutofillService.appLabel）：只需要能看到有桌面图标的应用 -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.xunlei.downloadprovider" />
    </queries>

    <application
        android:name=".MafariApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher_default"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_default"
        android:supportsRtl="true"
        android:theme="@style/Theme.MiuixBrowser"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MiuixBrowser">
        </activity>

        <!-- 原生播放页：只接受应用内显式 Intent，不导出。支持系统画中画；后台播放由下面的 PlayerService 保活 -->
        <activity
            android:name=".player.NativePlayerActivity"
            android:exported="false"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density|fontScale"
            android:theme="@style/Theme.MiuixBrowser.Player" />

        <!-- 响应系统里的 http(s) 链接：无界面的分流入口（原来声明在 MainActivity 上），按「外部链接打开方式」转给主界面 / 自定义标签页 / 其他浏览器。
             不加 launchMode：调用方不带 NEW_TASK 时，它和后面的自定义标签页都留在调用方的任务里。
             独立 taskAffinity：不少应用（如 Telegram 等）会带 NEW_TASK 打开链接，若用默认 affinity 会并进 / 拉起 Mafari 主界面所在任务（看起来像「跳到 Mafari」）；
             用单独的 affinity 后只会新建一个只含自定义标签页的任务，且不进最近任务，返回直接回到原应用 -->
        <activity
            android:name=".LinkDispatchActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="${applicationId}.customtab"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- 系统「打开方式」/ 分享菜单里的网页 / 纯文本文件：文件管理器 / 聊天 / 邮件等交来的 content:// 或 file:// 本地文件。
             无界面：先把文件拷进应用私有目录（纯文本会包成一页可读的 HTML）再交给 MainActivity 打开（见 LocalHtml）。
             不是 http(s) 链接，所以不影响「默认浏览器」的判定 -->
        <activity
            android:name=".HtmlOpenActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="${applicationId}.htmlopen"
            android:theme="@style/Theme.MafariTranslucent">
            <!-- 1) 系统给出了正确的 MIME（网页 / MHTML / 纯文本） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/html" />
                <data android:mimeType="application/xhtml+xml" />
                <data android:mimeType="multipart/related" />
                <data android:mimeType="application/x-mimearchive" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
            </intent-filter>
            <!-- 2) 文件管理器没给 MIME（或给了 octet-stream / */*）：按扩展名匹配（含大写）。
                 文件名中间带点（a.b.html）时单个 .*\\. 匹配不稳，所以多写几档 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.html" />
                <data android:pathPattern=".*\\..*\\.html" />
                <data android:pathPattern=".*\\..*\\..*\\.html" />
                <data android:pathPattern=".*\\.HTML" />
                <data android:pathPattern=".*\\..*\\.HTML" />
                <data android:pathPattern=".*\\..*\\..*\\.HTML" />
                <data android:pathPattern=".*\\.htm" />
                <data android:pathPattern=".*\\..*\\.htm" />
                <data android:pathPattern=".*\\..*\\..*\\.htm" />
                <data android:pathPattern=".*\\.HTM" />
                <data android:pathPattern=".*\\..*\\.HTM" />
                <data android:pathPattern=".*\\..*\\..*\\.HTM" />
                <data android:pathPattern=".*\\.xhtml" />
                <data android:pathPattern=".*\\..*\\.xhtml" />
                <data android:pathPattern=".*\\..*\\..*\\.xhtml" />
                <data android:pathPattern=".*\\.XHTML" />
                <data android:pathPattern=".*\\..*\\.XHTML" />
                <data android:pathPattern=".*\\..*\\..*\\.XHTML" />
                <data android:pathPattern=".*\\.xht" />
                <data android:pathPattern=".*\\..*\\.xht" />
                <data android:pathPattern=".*\\..*\\..*\\.xht" />
                <data android:pathPattern=".*\\.XHT" />
                <data android:pathPattern=".*\\..*\\.XHT" />
                <data android:pathPattern=".*\\..*\\..*\\.XHT" />
                <data android:pathPattern=".*\\.shtml" />
                <data android:pathPattern=".*\\..*\\.shtml" />
                <data android:pathPattern=".*\\..*\\..*\\.shtml" />
                <data android:pathPattern=".*\\.SHTML" />
                <data android:pathPattern=".*\\..*\\.SHTML" />
                <data android:pathPattern=".*\\..*\\..*\\.SHTML" />
                <data android:pathPattern=".*\\.shtm" />
                <data android:pathPattern=".*\\..*\\.shtm" />
                <data android:pathPattern=".*\\..*\\..*\\.shtm" />
                <data android:pathPattern=".*\\.SHTM" />
                <data android:pathPattern=".*\\..*\\.SHTM" />
                <data android:pathPattern=".*\\..*\\..*\\.SHTM" />
                <data android:pathPattern=".*\\.mhtml" />
                <data android:pathPattern=".*\\..*\\.mhtml" />
                <data android:pathPattern=".*\\..*\\..*\\.mhtml" />
                <data android:pathPattern=".*\\.MHTML" />
                <data android:pathPattern=".*\\..*\\.MHTML" />
                <data android:pathPattern=".*\\..*\\..*\\.MHTML" />
                <data android:pathPattern=".*\\.mht" />
                <data android:pathPattern=".*\\..*\\.mht" />
                <data android:pathPattern=".*\\..*\\..*\\.mht" />
                <data android:pathPattern=".*\\.MHT" />
                <data android:pathPattern=".*\\..*\\.MHT" />
                <data android:pathPattern=".*\\..*\\..*\\.MHT" />
                <data android:pathPattern=".*\\.txt" />
                <data android:pathPattern=".*\\..*\\.txt" />
                <data android:pathPattern=".*\\..*\\..*\\.txt" />
                <data android:pathPattern=".*\\.TXT" />
                <data android:pathPattern=".*\\..*\\.TXT" />
                <data android:pathPattern=".*\\..*\\..*\\.TXT" />
                <data android:pathPattern=".*\\.text" />
                <data android:pathPattern=".*\\..*\\.text" />
                <data android:pathPattern=".*\\..*\\..*\\.text" />
                <data android:pathPattern=".*\\.TEXT" />
                <data android:pathPattern=".*\\..*\\.TEXT" />
                <data android:pathPattern=".*\\..*\\..*\\.TEXT" />
                <data android:pathPattern=".*\\.log" />
                <data android:pathPattern=".*\\..*\\.log" />
                <data android:pathPattern=".*\\..*\\..*\\.log" />
                <data android:pathPattern=".*\\.LOG" />
                <data android:pathPattern=".*\\..*\\.LOG" />
                <data android:pathPattern=".*\\..*\\..*\\.LOG" />
                <data android:pathPattern=".*\\.md" />
                <data android:pathPattern=".*\\..*\\.md" />
                <data android:pathPattern=".*\\..*\\..*\\.md" />
                <data android:pathPattern=".*\\.MD" />
                <data android:pathPattern=".*\\..*\\.MD" />
                <data android:pathPattern=".*\\..*\\..*\\.MD" />
            </intent-filter>
            <!-- 3) 系统分享菜单（ACTION_SEND）：分享来的网页 / 文本文件（EXTRA_STREAM）。分享菜单没法区分「一个 txt 文件」和「一段文字」，
                 都是 text/plain，所以分享文字也会出现 Mafari：是链接就直接打开，其余文字包成一页可读文本（见 HtmlOpenActivity）。
                 分享菜单不看扩展名，只有发送方给了对应的 MIME 才会出现 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/html" />
                <data android:mimeType="application/xhtml+xml" />
                <data android:mimeType="multipart/related" />
                <data android:mimeType="application/x-mimearchive" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
            </intent-filter>
        </activity>

        <!-- 系统「打开方式」/ 分享菜单里的本地视频：无界面，直接交给原生播放页全屏播放（见 VideoOpenActivity）。
             独立 taskAffinity：返回直接回到调用方应用，不拉起 Mafari 主界面 -->
        <activity
            android:name=".VideoOpenActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="${applicationId}.videoopen"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/x-matroska" />
                <data android:mimeType="application/vnd.rn-realmedia" />
            </intent-filter>
            <!-- 没给 MIME 时按扩展名匹配 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.mp4" />
                <data android:pathPattern=".*\\..*\\.mp4" />
                <data android:pathPattern=".*\\..*\\..*\\.mp4" />
                <data android:pathPattern=".*\\.MP4" />
                <data android:pathPattern=".*\\..*\\.MP4" />
                <data android:pathPattern=".*\\..*\\..*\\.MP4" />
                <data android:pathPattern=".*\\.m4v" />
                <data android:pathPattern=".*\\..*\\.m4v" />
                <data android:pathPattern=".*\\..*\\..*\\.m4v" />
                <data android:pathPattern=".*\\.M4V" />
                <data android:pathPattern=".*\\..*\\.M4V" />
                <data android:pathPattern=".*\\..*\\..*\\.M4V" />
                <data android:pathPattern=".*\\.mkv" />
                <data android:pathPattern=".*\\..*\\.mkv" />
                <data android:pathPattern=".*\\..*\\..*\\.mkv" />
                <data android:pathPattern=".*\\.MKV" />
                <data android:pathPattern=".*\\..*\\.MKV" />
                <data android:pathPattern=".*\\..*\\..*\\.MKV" />
                <data android:pathPattern=".*\\.webm" />
                <data android:pathPattern=".*\\..*\\.webm" />
                <data android:pathPattern=".*\\..*\\..*\\.webm" />
                <data android:pathPattern=".*\\.WEBM" />
                <data android:pathPattern=".*\\..*\\.WEBM" />
                <data android:pathPattern=".*\\..*\\..*\\.WEBM" />
                <data android:pathPattern=".*\\.mov" />
                <data android:pathPattern=".*\\..*\\.mov" />
                <data android:pathPattern=".*\\..*\\..*\\.mov" />
                <data android:pathPattern=".*\\.MOV" />
                <data android:pathPattern=".*\\..*\\.MOV" />
                <data android:pathPattern=".*\\..*\\..*\\.MOV" />
                <data android:pathPattern=".*\\.avi" />
                <data android:pathPattern=".*\\..*\\.avi" />
                <data android:pathPattern=".*\\..*\\..*\\.avi" />
                <data android:pathPattern=".*\\.AVI" />
                <data android:pathPattern=".*\\..*\\.AVI" />
                <data android:pathPattern=".*\\..*\\..*\\.AVI" />
                <data android:pathPattern=".*\\.flv" />
                <data android:pathPattern=".*\\..*\\.flv" />
                <data android:pathPattern=".*\\..*\\..*\\.flv" />
                <data android:pathPattern=".*\\.FLV" />
                <data android:pathPattern=".*\\..*\\.FLV" />
                <data android:pathPattern=".*\\..*\\..*\\.FLV" />
                <data android:pathPattern=".*\\.3gp" />
                <data android:pathPattern=".*\\..*\\.3gp" />
                <data android:pathPattern=".*\\..*\\..*\\.3gp" />
                <data android:pathPattern=".*\\.3GP" />
                <data android:pathPattern=".*\\..*\\.3GP" />
                <data android:pathPattern=".*\\..*\\..*\\.3GP" />
                <data android:pathPattern=".*\\.3g2" />
                <data android:pathPattern=".*\\..*\\.3g2" />
                <data android:pathPattern=".*\\..*\\..*\\.3g2" />
                <data android:pathPattern=".*\\.3G2" />
                <data android:pathPattern=".*\\..*\\.3G2" />
                <data android:pathPattern=".*\\..*\\..*\\.3G2" />
                <data android:pathPattern=".*\\.wmv" />
                <data android:pathPattern=".*\\..*\\.wmv" />
                <data android:pathPattern=".*\\..*\\..*\\.wmv" />
                <data android:pathPattern=".*\\.WMV" />
                <data android:pathPattern=".*\\..*\\.WMV" />
                <data android:pathPattern=".*\\..*\\..*\\.WMV" />
                <data android:pathPattern=".*\\.mpg" />
                <data android:pathPattern=".*\\..*\\.mpg" />
                <data android:pathPattern=".*\\..*\\..*\\.mpg" />
                <data android:pathPattern=".*\\.MPG" />
                <data android:pathPattern=".*\\..*\\.MPG" />
                <data android:pathPattern=".*\\..*\\..*\\.MPG" />
                <data android:pathPattern=".*\\.mpeg" />
                <data android:pathPattern=".*\\..*\\.mpeg" />
                <data android:pathPattern=".*\\..*\\..*\\.mpeg" />
                <data android:pathPattern=".*\\.MPEG" />
                <data android:pathPattern=".*\\..*\\.MPEG" />
                <data android:pathPattern=".*\\..*\\..*\\.MPEG" />
                <data android:pathPattern=".*\\.ogv" />
                <data android:pathPattern=".*\\..*\\.ogv" />
                <data android:pathPattern=".*\\..*\\..*\\.ogv" />
                <data android:pathPattern=".*\\.OGV" />
                <data android:pathPattern=".*\\..*\\.OGV" />
                <data android:pathPattern=".*\\..*\\..*\\.OGV" />
                <data android:pathPattern=".*\\.mts" />
                <data android:pathPattern=".*\\..*\\.mts" />
                <data android:pathPattern=".*\\..*\\..*\\.mts" />
                <data android:pathPattern=".*\\.MTS" />
                <data android:pathPattern=".*\\..*\\.MTS" />
                <data android:pathPattern=".*\\..*\\..*\\.MTS" />
                <data android:pathPattern=".*\\.m2ts" />
                <data android:pathPattern=".*\\..*\\.m2ts" />
                <data android:pathPattern=".*\\..*\\..*\\.m2ts" />
                <data android:pathPattern=".*\\.M2TS" />
                <data android:pathPattern=".*\\..*\\.M2TS" />
                <data android:pathPattern=".*\\..*\\..*\\.M2TS" />
                <data android:pathPattern=".*\\.rmvb" />
                <data android:pathPattern=".*\\..*\\.rmvb" />
                <data android:pathPattern=".*\\..*\\..*\\.rmvb" />
                <data android:pathPattern=".*\\.RMVB" />
                <data android:pathPattern=".*\\..*\\.RMVB" />
                <data android:pathPattern=".*\\..*\\..*\\.RMVB" />
                <data android:pathPattern=".*\\.vob" />
                <data android:pathPattern=".*\\..*\\.vob" />
                <data android:pathPattern=".*\\..*\\..*\\.vob" />
                <data android:pathPattern=".*\\.VOB" />
                <data android:pathPattern=".*\\..*\\.VOB" />
                <data android:pathPattern=".*\\..*\\..*\\.VOB" />
            </intent-filter>
            <!-- 系统分享菜单（ACTION_SEND）：分享来的本地视频（EXTRA_STREAM） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/x-matroska" />
                <data android:mimeType="application/vnd.rn-realmedia" />
            </intent-filter>
        </activity>

        <!-- 自定义标签页：叠在调用方任务里的轻量网页窗口（标准启动模式，不要 document 模式 / 独立任务） -->
        <activity
            android:name=".CustomTabActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="${applicationId}.customtab"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MiuixBrowser" />

        <!-- Custom Tabs 服务：其他应用靠它识别 Mafari 支持自定义标签页 -->
        <service
            android:name=".MafariCustomTabsService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.support.customtabs.action.CustomTabsService" />
            </intent-filter>
        </service>

        <!-- 扫一扫：CameraX + ML Kit 内置版识别，只由菜单里的「扫一扫」启动 -->
        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density|fontScale"
            android:theme="@style/Theme.MiuixBrowser" />

        <!-- 「添加到桌面」生成的轻应用：独立任务、无底栏；同一网址再次点图标回到已打开的那一个 -->
        <activity
            android:name=".WebAppActivity"
            android:exported="false"
            android:documentLaunchMode="intoExisting"
            android:autoRemoveFromRecents="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MiuixBrowser" />

        <!-- 应用图标：同一时间只启用一个 alias，见 AppIconManager。
             alias 名带 V2 / V3：换图标资源后改名，让桌面启动器丢弃按旧组件名缓存的图标（否则会一直显示旧图 / 默认图）。
             默认(白底) ↔ 深蓝、多彩 ↔ 深色、极简 ↔ 极暗 随显示模式成对切换；经典无深色版。 -->
        <activity-alias
            android:name=".IconDefaultV3"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_default"
            android:roundIcon="@mipmap/ic_launcher_default"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconClassicV3"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
