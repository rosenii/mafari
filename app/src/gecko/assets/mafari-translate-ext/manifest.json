{
  "manifest_version": 2,
  "name": "Mafari Translate",
  "version": "1.0.0",
  "description": "Mafari 页内翻译的 Gecko 适配层（与 WebView 共用同一份 mafari_translate.js）",
  "browser_specific_settings": { "gecko": { "id": "translate@mafari.dev" } },
  "permissions": [
    "<all_urls>",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["translate.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
