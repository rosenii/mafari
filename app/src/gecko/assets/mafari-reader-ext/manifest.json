{
  "manifest_version": 2,
  "name": "Mafari Reader",
  "version": "1.2.0",
  "description": "Mafari 阅读模式的 Gecko 适配层（与 WebView 共用同一份 mafari_reader.js）",
  "browser_specific_settings": { "gecko": { "id": "reader@mafari.dev" } },
  "permissions": [
    "<all_urls>",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["reader.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["pause-hidden.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["scroll-metrics.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
