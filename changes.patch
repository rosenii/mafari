+    /** 忽略片段和末尾斜杠后是否同一个地址（判断 SSL 错误是不是当前主框架页面的）。 */
+    fun sameUrl(a: String?, b: String?): Boolean {
+        fun norm(u: String?) = u.orEmpty().substringBefore('#').trimEnd('/').lowercase()
+        val x = norm(a)
+        return x.isNotEmpty() && x == norm(b)
+    }
